    "defaultTemplate": {
        "base": [
            {
                "url": "template:_images/ubuntu"
            },
            {
                "url": "template:_default/mounts"
            }
        ],
        "minimumLimaVersion": "2.0.0",
        "vmOpts": {
            "qemu": {
                "cpuType": null,
                "minimumVersion": null
            },
            "vz": {
                "diskImageFormat": null,
                "rosetta": {
                    "binfmt": null,
                    "enabled": null
                }
            }
        },
        "os": "Linux",
        "arch": "aarch64",
        "cpus": 4,
        "memory": "4GiB",
        "disk": "100GiB",
        "mountInotify": false,
        "ssh": {
            "localPort": 0,
            "loadDotSSHPubKeys": false,
            "forwardAgent": false,
            "forwardX11": false,
            "forwardX11Trusted": false
        },
        "firmware": {
            "legacyBIOS": false
        },
        "audio": {
            "device": "",
            "interface": "",
            "microphone": false
        },
        "video": {
            "display": "none",
            "vnc": {}
        },
        "upgradePackages": false,
        "containerd": {
            "system": false,
            "user": true,
            "archives": [
                {
                    "location": "https://github.com/containerd/nerdctl/releases/download/v2.4.2/nerdctl-full-2.4.2-linux-amd64.tar.gz",
                    "arch": "x86_64",
                    "digest": "sha256:1f12c1a5840744fdf7029483c55a69813d44aa2ec1ef879d52d81ff6a3049ecd"
                },
                {
                    "location": "https://github.com/containerd/nerdctl/releases/download/v2.4.2/nerdctl-full-2.4.2-linux-arm64.tar.gz",
                    "arch": "aarch64",
                    "digest": "sha256:fe0ef0e9840ee8932640e6058f84b7fa98050f9726e44af44883a5b804ae830e"
                }
            ]
        },
        "guestInstallPrefix": "/usr/local",
        "networkOpts": {
            "hostLoopback": true
        },
        "hostResolver": {
            "ipv6": false
        },
        "propagateProxyEnv": true,
        "caCerts": {
            "removeDefaults": false
        },
        "rosetta": {},
        "plain": false,
        "timezone": "Asia/Seoul",
        "nestedVirtualization": false,
        "user": {
            "name": "<host-user>",
            "comment": "<host-display-name>",
            "home": "<guest-home>",
            "shell": "/bin/bash",
            "uid": 501,
            "passwordlessSudo": true
        },
        "tpm": false
    },
    "limaHome": "<task-root>/lima",
    "vmTypes": [
        "qemu",
        "vz",
        "krunkit"
    ],
    "vmTypesEx": {
        "krunkit": {
            "location": "<task-root>/prefix/libexec/lima/lima-driver-krunkit"
        },
        "qemu": {
            "location": "internal"
        },
        "vz": {
            "location": "internal"
        }
    },
    "guestAgents": {
        "Darwin-aarch64": {
            "location": "<task-root>/prefix/share/lima/lima-guestagent.Darwin-aarch64.gz"
        },
        "aarch64": {
            "location": "<task-root>/prefix/share/lima/lima-guestagent.Linux-aarch64.gz"
        }
    },
    "shellEnvBlock": [
        "BASH*",
        "DISPLAY",
        "DYLD_*",
        "EUID",
        "FPATH",
        "GID",
        "GROUP",
        "HOME",
        "HOSTNAME",
        "LD_*",
        "LOGNAME",
        "OLDPWD",
        "PATH",
        "PWD",
        "SHELL",
        "SHLVL",
        "SSH_*",
        "TERM",
        "TERMINFO",
        "TMPDIR",
        "UID",
        "USER",
        "XAUTHORITY",
        "XDG_*",
        "ZDOTDIR",
        "ZSH*",
        "_*"
    ],
    "hostOS": "darwin",
    "hostArch": "aarch64",
    "identityFile": "<task-root>/lima/_config/user",
    "plugins": [
        {
            "name": "mcp",
            "path": "<task-root>/prefix/libexec/lima/limactl-mcp"
        },
        {
            "name": "menu",
            "path": "<task-root>/prefix/libexec/lima/limactl-menu"
        },
        {
            "name": "url-fedora-rawhide",
            "path": "<task-root>/prefix/libexec/lima/limactl-url-fedora-rawhide"
        }
    ],
    "libexecPaths": [
        "<task-root>/prefix/libexec/lima",
        "<task-root>/prefix/libexec/lima"
    ],
    "sharePaths": [
        "<task-root>/prefix/share/lima",
        "<task-root>/prefix/share/lima"
    ]
}
