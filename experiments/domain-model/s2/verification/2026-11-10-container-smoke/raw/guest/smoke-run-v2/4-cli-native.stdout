        "Spec": {
            "ociVersion": "1.3.0",
            "process": {
                "user": {
                    "uid": 1000,
                    "gid": 1000,
                    "additionalGids": [
                        1000
                    ]
                },
                "args": [
                    "docker-entrypoint.sh",
                    "sh",
                    "-c",
                    "#!/bin/sh\nset -eu\n# Invoked in a fresh nonprivileged, network-none container; no model session.\ncase \"$1\" in\n  basic)\n    printf 'S2_SMOKE_STARTED\\n'\n    id\n    node -e 'if(process.version!==\"v22.19.0\" || process.getuid()!==1000 || process.getgid()!==1000) process.exit(9); console.log(JSON.stringify({kind:\"fixed-local-smoke\",value:42,node:process.version,uid:process.getuid(),gid:process.getgid()}))'\n    node -e 'const fs=require(\"fs\"); const read=n=>fs.readFileSync(\"/sys/fs/cgroup/\"+n,\"utf8\").trim(); const cpu=read(\"cpu.max\").split(\" \").map(Number); const limits={cpuMax:read(\"cpu.max\"),memoryMax:read(\"memory.max\"),pidsMax:read(\"pids.max\")}; if(cpu[0]/cpu[1]!==2 || limits.memoryMax!==\"4294967296\" || limits.pidsMax!==\"256\") process.exit(10);console.log(JSON.stringify(limits))'\n    cat /proc/self/status\n    cat /proc/self/mountinfo\n    ;;\n  exit7)\n    printf 'S2_EXIT7_STARTED\\n'\n    exit 7\n    ;;\n  cli)\n    printf 'S2_CLI_STARTED\\n'\n    mkdir -p /tmp/smoke-home/codex\n    test -z \"$(ls -A /tmp/smoke-home/codex)\"\n    codex --version\n    codex --help\n    command -v codex\n    sha256sum \"$(command -v codex)\"\n    find /usr/local/lib/node_modules/@openai -type f -name codex -exec sha256sum '{}' ';'\n    ;;\n  *) exit 64 ;;\nesac\n",
                    "smoke",
                    "cli"
                ],
                "env": [
                    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                    "NODE_VERSION=22.19.0",
                    "YARN_VERSION=1.22.22",
                    "NODE_PATH=/usr/local/lib/node_modules",
                    "HOME=/tmp/smoke-home",
                    "CODEX_HOME=/tmp/smoke-home/codex",
                    "HOSTNAME=4390e04f5fdc"
                ],
                "cwd": "/source",
                "capabilities": {},
                "noNewPrivileges": true,
                "apparmorProfile": "nerdctl-default"
