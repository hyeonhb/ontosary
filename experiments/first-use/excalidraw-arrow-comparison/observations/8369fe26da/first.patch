+import React from "react";
+
+import { pointFrom } from "@excalidraw/math";
+
+import type { LocalPoint } from "@excalidraw/math";
+
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Pointer, UI } from "./helpers/ui";
+import { render } from "./test-utils";
+
+const mouse = new Pointer("mouse");
+
+it("erases an arrow crossed between pointer samples but leaves a locked arrow", async () => {
+  await render(<Excalidraw />);
+
+  const points = [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(100, 0)];
+  const arrow = API.createElement({
+    type: "arrow",
+    x: 50,
+    y: 100,
+    width: 100,
+    height: 0,
+    points,
+  });
+  const lockedArrow = API.createElement({
+    type: "arrow",
+    x: 50,
+    y: 120,
+    width: 100,
+    height: 0,
+    points,
+    locked: true,
+  });
+  API.setElements([arrow, lockedArrow]);
+  API.setAppState({ width: 300, height: 300 });
+  UI.clickTool("eraser");
+
+  mouse.downAt(100, 60);
+  mouse.moveTo(100, 160);
+  mouse.up();
+
+  expect(API.getElement(arrow).isDeleted).toBe(true);
+  expect(API.getElement(lockedArrow).isDeleted).toBe(false);
+});
