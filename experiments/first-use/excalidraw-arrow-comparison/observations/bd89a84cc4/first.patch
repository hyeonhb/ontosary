+import React from "react";
+
+import { pointFrom } from "@excalidraw/math";
+import type { LocalPoint } from "@excalidraw/math";
+
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Pointer, UI } from "./helpers/ui";
+import {
+  mockBoundingClientRect,
+  render,
+  restoreOriginalGetBoundingClientRect,
+} from "./test-utils";
+
+const { h } = window;
+const mouse = new Pointer("mouse");
+
+beforeEach(async () => {
+  mockBoundingClientRect({ width: 500, height: 500 });
+  await render(<Excalidraw />);
+  UI.clickTool("eraser");
+});
+
+afterEach(restoreOriginalGetBoundingClientRect);
+
+it("erases an arrow crossed between pointer samples but leaves a locked arrow", () => {
+  const arrow = API.createElement({
+    type: "arrow",
+    x: 50,
+    y: 75,
+    width: 200,
+    height: 0,
+    points: [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(200, 0)],
+    roundness: null,
+  });
+  const lockedArrow = API.createElement({
+    ...arrow,
+    id: "locked-arrow",
+    y: 125,
+    locked: true,
+  });
+  API.setElements([arrow, lockedArrow]);
+
+  mouse.downAt(150, 20);
+  mouse.moveTo(150, 180);
+  mouse.up();
+
+  expect(h.elements.filter((element) => !element.isDeleted)).toEqual([
+    expect.objectContaining({ id: lockedArrow.id, locked: true }),
+  ]);
+});
