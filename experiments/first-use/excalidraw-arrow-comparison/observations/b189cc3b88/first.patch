+import React from "react";
+
+import { ROUNDNESS } from "@excalidraw/common";
+import { pointFrom } from "@excalidraw/math";
+
+import type { LocalPoint } from "@excalidraw/math";
+
+import { Excalidraw } from "../index";
+
+import { API } from "./helpers/api";
+import { Pointer, UI } from "./helpers/ui";
+import {
+  mockBoundingClientRect,
+  render,
+  restoreOriginalGetBoundingClientRect,
+} from "./test-utils";
+
+describe("eraser", () => {
+  beforeEach(() => mockBoundingClientRect({ width: 800, height: 600 }));
+  afterEach(restoreOriginalGetBoundingClientRect);
+
+  it.each([false, true])(
+    "erases only unlocked arrows crossed between pointer samples (rounded: %s)",
+    async (rounded) => {
+      await render(<Excalidraw />);
+
+      const arrow = API.createElement({
+        type: "arrow",
+        x: 100,
+        y: 100,
+        width: 120,
+        height: 0,
+        points: [pointFrom<LocalPoint>(0, 0), pointFrom<LocalPoint>(120, 0)],
+        roundness: rounded ? { type: ROUNDNESS.PROPORTIONAL_RADIUS } : null,
+      });
+      const lockedArrow = { ...arrow, id: "locked", locked: true };
+      const missedArrow = { ...arrow, id: "missed", x: 300 };
+      API.setElements([arrow, lockedArrow, missedArrow]);
+      UI.clickTool("eraser");
+
+      const mouse = new Pointer("mouse");
+      mouse.downAt(160, 50);
+      mouse.moveTo(160, 150);
+      mouse.up();
+
+      expect(API.getElement(arrow).isDeleted).toBe(true);
+      expect(API.getElement(lockedArrow).isDeleted).toBe(false);
+      expect(API.getElement(missedArrow).isDeleted).toBe(false);
+    },
+  );
+});
