{
  "name": "ontosary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based domain discovery from existing TypeScript code",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "ontosary": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/react-vite/tsconfig.json && tsc --noEmit -p experiments/domain-model/s2/tsconfig.json",
    "test": "pnpm build && vitest run",
    "ontosary": "node dist/cli/index.js",
    "example:dev": "vite examples/react-vite",
    "example:build": "vite build examples/react-vite",
    "experiment": "pnpm build && node experiments/run.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm example:build",
    "experiment:corpus:prepare": "node experiments/corpus/prepare.mjs",
    "experiment:corpus": "pnpm build && node experiments/corpus/v3/run.mjs",
    "experiment:corpus:v1": "pnpm build && node experiments/corpus/run.mjs",
    "experiment:corpus:v2": "pnpm build && node experiments/corpus/v2/run.mjs",
    "s2:build": "tsc -p experiments/domain-model/s2/tsconfig.json",
    "s2:prepare": "pnpm s2:build && node work/s2-build/prepare.js",
    "s2:evaluate": "pnpm s2:build && node work/s2-build/evaluation/run.js",
    "s2:oracle-check": "pnpm s2:build && node work/s2-build/evaluation/oracle-check.js",
    "s2:workspace": "pnpm s2:build && node work/s2-build/workspace.js",
    "s2:verify": "pnpm s2:build && node work/s2-build/verify.js",
    "s2:verify-evaluation": "pnpm s2:build && node work/s2-build/evaluation/verify.js",
    "s2:trial:probe": "pnpm s2:build && node work/s2-build/trial/probe.js",
    "s2:trial:environment": "pnpm s2:build && node work/s2-build/trial/environment.js",
    "s2:trial:validate-public": "pnpm s2:build && node work/s2-build/trial/validate-environment.js",
    "s2:trial:validate-workspaces": "pnpm s2:build && node work/s2-build/trial/validate-workspaces.js",
    "s2:trial:freeze": "pnpm s2:build && node work/s2-build/trial/freeze.js freeze",
    "s2:trial:run": "pnpm s2:build && node work/s2-build/trial/freeze.js run"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonhb/ontosary.git"
  }
}
